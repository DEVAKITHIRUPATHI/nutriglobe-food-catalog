{
  "version": 2,
  "framework": "vite",
  "outputDirectory": "dist/public",
  "cleanUrls": true,
  "functions": {
    "api/index.ts": {
      "runtime": "nodejs20.x",
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/api",
      "destination": "/api/index"
    },
    {
      "source": "/health",
      "destination": "/api/index"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/((?!api/|dist/|server/|.*\\.(?:cjs|mjs|map|ts|tsx)$).*)",
      "destination": "/index.html"
    }
  ]
}
